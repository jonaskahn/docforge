#!/usr/bin/env sh
# docforge — resolve the Docforge cartridge and run a tool launcher, or link
# the runtime into the current repository.
#
# The cartridge (_shared/) is resolved in this order:
#   1. $DOCFORGE_SHARED                      — explicit path to a _shared/ dir
#   2. $DOCFORGE_SKILL/_shared               — explicit path to a skill dir
#   3. this script's own location            — works when run/symlinked from
#                                              inside a cartridge
#   4. ancestors of the cwd:                 — <dir>/skills/docforge/_shared
#                                              (repo-local skill checkout), or
#                                              <dir>/runtime (a runtime link
#                                              installed with `install`)
#   5. global skill dirs:                    — ~/.agents/skills/docforge/_shared,
#                                              ~/.claude/skills/docforge/_shared,
#                                              ~/.config/opencode/skills/docforge/_shared
#
# So a repo-local install works with plain documented commands
# (`python3 runtime/cli/python/<tool>.py ...`) from the repo root, and the
# `docforge` bin works from any directory once the skill is installed
# globally or in the repo.

set -eu

usage() {
  cat <<'EOF'
usage: docforge <command> [args…]

commands:
  which                        print the resolved cartridge root
  python <tool> [args…]        run the Python launcher for <tool>
  js <tool> [args…]            run the JS launcher for <tool> (node/bun/deno)
  run <tool> [args…]           run <tool>; engine = $DOCFORGE_ENGINE or the
                               first available of python3|python, node, bun, deno
  install [--local] [--repo <path>]   symlink <repo>/runtime -> cartridge runtime
  install --global [--dest <dir>]     symlink the whole skill into a global dir
                               (default ~/.agents/skills/docforge)

environment:
  DOCFORGE_SHARED   explicit path to the _shared/ cartridge
  DOCFORGE_SKILL    explicit path to the skill dir containing _shared/
  DOCFORGE_ENGINE   engine for `run`: python3|python|node|bun|deno
EOF
}

self="$0"
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname -- "$self")/$link" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)

CARTRIDGE=""

find_cartridge() {
  CARTRIDGE=""
  if [ -n "${DOCFORGE_SHARED:-}" ] && [ -d "$DOCFORGE_SHARED/runtime/cli" ]; then
    CARTRIDGE="$DOCFORGE_SHARED"
    return 0
  fi
  if [ -n "${DOCFORGE_SKILL:-}" ] && [ -d "$DOCFORGE_SKILL/_shared/runtime/cli" ]; then
    CARTRIDGE="$DOCFORGE_SKILL/_shared"
    return 0
  fi
  if [ -d "$SCRIPT_DIR/runtime/cli" ]; then
    CARTRIDGE="$SCRIPT_DIR"
    return 0
  fi
  D=$(pwd)
  while :; do
    if [ -d "$D/skills/docforge/_shared/runtime/cli" ]; then
      CARTRIDGE="$D/skills/docforge/_shared"
      return 0
    fi
    if [ -f "$D/runtime/cli/README.md" ]; then
      R=$(CDPATH= cd "$D/runtime" && pwd -P)
      CARTRIDGE=$(dirname "$R")
      return 0
    fi
    [ "$D" = "/" ] && break
    D=$(dirname "$D")
  done
  for g in \
    "$HOME/.agents/skills/docforge/_shared" \
    "$HOME/.claude/skills/docforge/_shared" \
    "$HOME/.config/opencode/skills/docforge/_shared"; do
    if [ -d "$g/runtime/cli" ]; then
      CARTRIDGE="$g"
      return 0
    fi
  done
  return 1
}

cmd_python() {
  tool=$1; shift || true
  P=$(command -v python3 || command -v python || true)
  if [ -z "$P" ]; then
    echo "docforge: no python3/python on PATH" >&2
    exit 1
  fi
  exec "$P" "$CARTRIDGE/runtime/cli/python/$tool.py" "$@"
}

cmd_js() {
  tool=$1; shift || true
  for e in node bun deno; do
    if command -v "$e" >/dev/null 2>&1; then
      if [ "$e" = "deno" ]; then
        exec deno run -A "$CARTRIDGE/runtime/cli/js/$tool.js" "$@"
      fi
      exec "$e" "$CARTRIDGE/runtime/cli/js/$tool.js" "$@"
    fi
  done
  echo "docforge: no node/bun/deno on PATH" >&2
  exit 1
}

cmd_run() {
  engine="${DOCFORGE_ENGINE:-}"
  case "$engine" in
    "")
      if command -v python3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1; then
        cmd_python "$@"
      else
        cmd_js "$@"
      fi
      ;;
    python3 | python) cmd_python "$@" ;;
    node | bun | deno) cmd_js "$@" ;;
    *)
      echo "docforge: unknown DOCFORGE_ENGINE: $engine (expected python3|python|node|bun|deno)" >&2
      exit 1
      ;;
  esac
}

cmd_install() {
  mode=local
  dest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --local) mode=local ;;
      --global) mode=global ;;
      --repo) dest=$2; shift ;;
      --dest) dest=$2; shift ;;
      *)
        echo "docforge: unknown install flag: $1" >&2
        usage
        exit 2
        ;;
    esac
    shift
  done

  if [ "$mode" = "global" ]; then
    [ -n "$dest" ] || dest="$HOME/.agents/skills/docforge"
    src=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd -P)
    if [ ! -f "$src/SKILL.md" ]; then
      echo "docforge: no SKILL.md next to $src — cannot install globally" >&2
      exit 1
    fi
    if [ -e "$dest" ]; then
      echo "docforge: $dest already exists — remove it first (or use --dest)" >&2
      exit 1
    fi
    mkdir -p "$(dirname "$dest")"
    ln -s "$src" "$dest"
    echo "linked $dest -> $src"
    echo "note: add $dest/bin to PATH, or run:"
    echo "  ln -s $dest/bin/docforge /usr/local/bin/docforge"
    return 0
  fi

  [ -n "$dest" ] || dest=$(pwd)
  if [ -e "$dest/runtime" ]; then
    echo "docforge: $dest/runtime already exists — remove it first (or use --repo)" >&2
    exit 1
  fi
  case "$CARTRIDGE" in
    "$dest"/*)
      rel=${CARTRIDGE#"$dest"/}
      ln -s "$rel/runtime" "$dest/runtime"
      ;;
    *)
      ln -s "$CARTRIDGE/runtime" "$dest/runtime"
      ;;
  esac
  echo "linked $dest/runtime -> $(readlink "$dest/runtime")"
  echo "note: the link is either committed or gitignored by your repo; a committed absolute link only resolves on machines with the same cartridge path."
}

if [ $# -eq 0 ]; then
  usage
  exit 2
fi
cmd=$1
shift

case "$cmd" in
  which)
    if ! find_cartridge; then
      echo "docforge: cartridge not found (set DOCFORGE_SHARED or install the skill)" >&2
      exit 1
    fi
    echo "$CARTRIDGE"
    ;;
  python | js | run | install)
    if ! find_cartridge; then
      echo "docforge: cartridge not found (set DOCFORGE_SHARED or install the skill)" >&2
      exit 1
    fi
    case "$cmd" in
      python) cmd_python "$@" ;;
      js) cmd_js "$@" ;;
      run) cmd_run "$@" ;;
      install) cmd_install "$@" ;;
    esac
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "docforge: unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac

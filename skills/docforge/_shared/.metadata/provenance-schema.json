{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docforge Provenance 2.2",
  "type": "object",
  "required": ["schema", "doc_id", "path", "generated_at", "generator", "tier", "target_depth", "graph", "sections"],
  "properties": {
    "schema": {"enum": ["2.0", "2.1", "2.2"]},
    "doc_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tier": {"type": "string", "minLength": 1},
    "target_depth": {"type": "string", "minLength": 1},
    "graph": {
      "type": "object",
      "required": ["provider", "flow"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "flow": {
          "anyOf": [
            {"enum": ["native", "derived", "none"]},
            {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
          ]
        }
      },
      "additionalProperties": false
    },
    "git_commit": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
      ]
    },
    "content_hash": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
      ]
    },
    "review": {
      "type": "object",
      "required": ["mode", "verdict"],
      "properties": {
        "mode": {"enum": ["cold-pass"]},
        "verdict": {"enum": ["PASS", "FAIL"]},
        "report": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sources", "unresolved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "git_blob", "role"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "git_blob_normalized": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "evidence_range": {
                  "type": "object",
                  "required": ["start", "end"],
                  "properties": {
                    "start": {"type": "string", "pattern": "^[1-9][0-9]*$"},
                    "end": {"type": "string", "pattern": "^[1-9][0-9]*$"}
                  },
                  "additionalProperties": false
                },
                "range_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "role": {"enum": ["code", "config", "manifest", "doc", "test", "history"]}
              },
              "additionalProperties": false,
              "dependencies": {
                "evidence_range": ["range_blob"],
                "range_blob": ["evidence_range"]
              }
            }
          },
          "unresolved": {"type": "array", "items": {"type": "string"}},
          "external_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "relation", "supports"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "relation": {"enum": ["primary-source", "supporting-source", "method", "terminology"]},
                "supports": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "external_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "title", "kind", "accessed_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string"},
          "kind": {"enum": ["standard", "official-doc", "vendor-doc", "primary-research"]},
          "accessed_at": {
            "anyOf": [
              {"type": "string", "format": "date-time"},
              {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
            ]
          },
          "version": {"type": "string"},
          "locator": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

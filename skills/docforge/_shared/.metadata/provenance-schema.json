{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docforge Provenance 2.0",
  "type": "object",
  "required": ["schema", "doc_id", "path", "generated_at", "generator", "tier", "target_depth", "graph", "sections"],
  "properties": {
    "schema": {"const": "2.0"},
    "doc_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tier": {"type": "string", "minLength": 1},
    "target_depth": {"type": "string", "minLength": 1},
    "graph": {
      "type": "object",
      "required": ["provider", "flow"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "flow": {
          "anyOf": [
            {"enum": ["native", "derived", "none"]},
            {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
          ]
        }
      },
      "additionalProperties": false
    },
    "git_commit": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
      ]
    },
    "content_hash": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
      ]
    },
    "review": {
      "type": "object",
      "required": ["mode", "verdict"],
      "properties": {
        "mode": {"enum": ["subagent", "cold-pass"]},
        "verdict": {"enum": ["PASS", "FAIL"]},
        "report": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sources", "unresolved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "git_blob", "role"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "role": {"enum": ["code", "config", "manifest", "doc", "test", "history"]}
              },
              "additionalProperties": false
            }
          },
          "unresolved": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docforge Portfolio Repo Identity",
  "type": "object",
  "required": ["version", "packages"],
  "properties": {
    "version": {"const": "1.0"},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo_id", "ecosystem", "name"],
        "properties": {
          "repo_id": {
            "type": "string",
            "description": "Member repo id as used in repo-inventory"
          },
          "ecosystem": {
            "type": "string",
            "enum": ["npm", "composer", "pip", "cargo", "go", "gem", "maven", "gradle", "nuget", "pub"]
          },
          "name": {
            "type": "string",
            "description": "Declared package identifier for this member"
          },
          "coupling_default": {
            "type": "string",
            "enum": [
              "shared library",
              "API contract",
              "event schema",
              "provisions-for",
              "deploys-into"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

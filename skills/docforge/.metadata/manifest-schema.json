{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docforge Manifest 3.0",
  "type": "object",
  "required": ["version", "generated_at", "project", "discovery", "documents", "metadata"],
  "properties": {
    "version": {"const": "3.0"},
    "generated_at": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["name", "root", "tier", "profiles"],
      "properties": {
        "name": {"type": "string"},
        "root": {"type": "string"},
        "tier": {"enum": ["spine", "diligence", "portfolio"]},
        "profiles": {
          "type": "object",
          "required": ["shapes", "platforms", "frameworks", "concerns", "audiences"],
          "properties": {
            "shapes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "platforms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "frameworks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "concerns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "id", "confidence", "evidence"],
        "properties": {
          "dimension": {"enum": ["shapes", "platforms", "frameworks", "concerns"]},
          "id": {"type": "string"},
          "confidence": {"enum": ["confirmed", "candidate"]},
          "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "documents": {"type": "array", "items": {"$ref": "#/definitions/document"}},
    "metadata": {"type": "object"}
  },
  "definitions": {
    "origin": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["tier", "shape", "platform", "framework", "concern", "audience", "condition", "dynamic", "ancestor"]},
        "id": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["schema", "doc_id", "path", "generated_at", "tool_version", "tier", "target_depth", "graph", "sections"],
      "properties": {
        "schema": {"const": "1.0"},
        "doc_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "tier": {"type": "string", "minLength": 1},
        "target_depth": {"type": "string", "minLength": 1},
        "graph": {
          "type": "object",
          "required": ["provider", "flow"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "flow": {
              "anyOf": [
                {"enum": ["native", "derived", "none"]},
                {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
              ]
            }
          },
          "additionalProperties": false
        },
        "git_commit": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "string", "pattern": "^<[A-Z][A-Z0-9_]{2,}>$"}
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sources", "unresolved"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "git_blob", "role"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "role": {"enum": ["code", "config", "manifest", "doc", "test", "history"]}
                  },
                  "additionalProperties": false
                }
              },
              "unresolved": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["id", "type", "path", "group", "selection", "status", "requires", "scaffold_template", "target_depth", "write_order", "provenance_mode", "audit_profile", "provenance", "audit"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "path": {"type": "string"},
        "group": {"type": "string"},
        "selection": {
          "type": "object",
          "required": ["origins", "evidence"],
          "properties": {
            "origins": {"type": "array", "items": {"$ref": "#/definitions/origin"}},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "status": {"enum": ["planned", "in_progress", "generated", "needs_review", "complete", "skipped"]},
        "requires": {"type": "array", "items": {"enum": ["code_graph", "flow_graph", "manifests", "git_history"]}},
        "scaffold_template": {"type": "string"},
        "instruction_file": {"type": ["string", "null"]},
        "target_depth": {"type": "string"},
        "write_order": {"type": "integer"},
        "provenance_mode": {"enum": ["sections", "manifest"]},
        "audit_profile": {"type": "string"},
        "provenance": {"$ref": "#/definitions/provenance"},
        "audit": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["generated", "needs_review", "complete"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "provenance": {
                "allOf": [
                  {"$ref": "#/definitions/provenance"},
                  {
                    "properties": {
                      "doc_id": {"type": "string", "pattern": "^(?!<).+$"},
                      "path": {"type": "string", "pattern": "^(?!<).+$"},
                      "generated_at": {"type": "string", "format": "date-time", "pattern": "^(?!<).+$"},
                      "tool_version": {"type": "string", "pattern": "^(?!<).+$"},
                      "tier": {"enum": ["spine", "diligence", "portfolio"]},
                      "target_depth": {"type": "string", "pattern": "^(?!<).+$"},
                      "graph": {
                        "properties": {
                          "provider": {"type": "string", "pattern": "^(?!<).+$"},
                          "flow": {"enum": ["native", "derived", "none"]}
                        }
                      },
                      "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                      "sections": {"type": "array", "minItems": 1}
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}

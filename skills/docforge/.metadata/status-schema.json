{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generation Status Schema",
  "description": "Tracks runtime progress of document generation for a specific session",
  "type": "object",
  "required": ["version", "documents"],
  "properties": {
    "version": {
      "type": "string"
    },
    "session_id": {
      "type": ["string", "null"],
      "description": "Unique session identifier"
    },
    "start_time": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp when generation started"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Document ID from manifest"
          },
          "status": {
            "type": "string",
            "enum": ["planned", "querying", "writing", "complete", "skipped"],
            "description": "Current generation state"
          },
          "start_time": {
            "type": ["string", "null"],
            "description": "When this document generation started"
          },
          "end_time": {
            "type": ["string", "null"],
            "description": "When this document generation completed"
          },
          "tokens_used": {
            "type": ["integer", "null"],
            "description": "Token count for generation"
          },
          "error": {
            "type": ["string", "null"],
            "description": "Error message if generation failed"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docforge 1.0 Catalog",
  "type": "object",
  "required": ["version", "tiers", "overlays", "groups", "capabilities", "documents"],
  "properties": {
    "version": {"const": "1.0.2"},
    "tiers": {"type": "array", "items": {"$ref": "#/definitions/namedOrder"}},
    "overlays": {"type": "array", "items": {"$ref": "#/definitions/namedOrder"}},
    "groups": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"enum": ["code_graph", "flow_graph", "manifests", "git_history"]}},
    "documents": {"type": "array", "items": {"$ref": "#/definitions/document"}}
  },
  "definitions": {
    "namedOrder": {
      "type": "object",
      "required": ["id", "order"],
      "properties": {"id": {"type": "string"}, "order": {"type": "integer"}}
    },
    "document": {
      "type": "object",
      "required": ["id", "type", "path", "group", "selection", "scaffold_template", "requires", "target_depth", "write_order", "provenance_mode", "audit_profile"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "path": {"type": "string"},
        "group": {"type": "string"},
        "selection": {
          "type": "object",
          "required": ["mode", "min_tier", "overlays", "condition"],
          "properties": {
            "mode": {"enum": ["static", "dynamic"]},
            "min_tier": {"enum": ["spine", "diligence", "portfolio"]},
            "overlays": {"type": "array", "items": {"type": "string"}},
            "include_if_overlay": {"type": "array", "items": {"type": "string"}},
            "condition": {"type": ["string", "null"]}
          }
        },
        "scaffold_template": {"type": "string"},
        "instruction_file": {"type": ["string", "null"]},
        "requires": {"type": "array", "items": {"enum": ["code_graph", "flow_graph", "manifests", "git_history"]}},
        "target_depth": {"type": "string"},
        "write_order": {"type": "integer"},
        "provenance_mode": {"enum": ["sections", "manifest"]},
        "audit_profile": {"type": "string"}
      }
    }
  }
}
